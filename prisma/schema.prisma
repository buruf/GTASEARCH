// GTASearch — Prisma schema
// Design: docs/superpowers/specs/2026-07-28-gtasearch-phase1-design.md
//
// Phase 1 reads only User and Listing. Every other model is created now so that
// Phases 2 and 3 never require a destructive migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled, port 6543 — application queries
  directUrl = env("DIRECT_URL") // session pooler, port 5432 — migrations
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  emailVerified DateTime?

  listings            Listing[]
  savedListings       SavedListing[]
  sentMessages        Message[]      @relation("MessageSender")
  receivedMessages    Message[]      @relation("MessageRecipient")
  buyerConversations  Conversation[] @relation("ConversationBuyer")
  sellerConversations Conversation[] @relation("ConversationSeller")
  boostPayments       BoostPayment[]
  reportsFiled        Report[]
  ownedBusinesses     Business[]      @relation("BusinessOwner")
  businessClaims      BusinessClaim[] @relation("ClaimSubmitter")
  claimsReviewed      BusinessClaim[] @relation("ClaimReviewer")
  reviews             Review[]

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
}

model Listing {
  id            String   @id @default(cuid())
  title         String
  description   String
  price         Decimal? @db.Decimal(10, 2) // null when priceType is free/contact/trade
  priceType     String   @default("fixed") // "fixed" | "free" | "contact" | "trade"
  category      String
  subcategory   String?
  city          String
  neighbourhood String?

  // NEVER exposed to the client. Every listing query must use an explicit
  // `select` that omits this field; `SELECT *` on listings is prohibited.
  postalCode String?

  images         String[]
  status         String    @default("active") // "draft" | "active" | "sold" | "expired" | "deleted"
  boostLevel     String    @default("none") // "none" | "top" | "featured" | "super"
  boostExpiresAt DateTime?

  // Stored rather than derived from createdAt, so relisting works correctly and
  // the Phase 3 expiry-reminder job has a single source of truth.
  expiresAt DateTime
  // Set when the "expiring soon" reminder email is sent; cleared on relist so
  // each 30-day cycle gets exactly one reminder. Written only by the cron.
  expiryReminderAt DateTime?

  views  Int    @default(0)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Full-text search column. Prisma cannot express `tsvector` or the
  // GENERATED ALWAYS AS expression, so the migration is hand-edited to create it
  // as a generated column (title weight A, description weight B) with a GIN
  // index. Declared here as Unsupported so Prisma does not report schema drift
  // and try to drop it.
  searchVector Unsupported("tsvector")?

  conversations Conversation[]
  messages      Message[]
  savedBy       SavedListing[]
  boostPayments BoostPayment[]
  reports       Report[]

  @@index([category, city, status, createdAt])
  @@index([status, expiresAt])
  @@index([status, createdAt])
  @@index([userId])
}

// Threads a buyer's conversation with a seller about one listing. Without this,
// two buyers messaging the same seller are indistinguishable and no inbox can
// be built.
model Conversation {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([listingId, buyerId])
  @@index([sellerId, updatedAt])
  @@index([buyerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User         @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([recipientId, readAt])
}

model SavedListing {
  userId    String
  listingId String
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, savedAt])
}

model BoostPayment {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique so a replayed Stripe webhook cannot apply the same boost twice.
  stripeId String @unique

  amount     Decimal  @db.Decimal(10, 2)
  boostLevel String
  duration   Int // days
  status     String   @default("pending") // "pending" | "paid" | "failed" | "refunded"
  createdAt  DateTime @default(now())

  @@index([listingId])
  @@index([userId, createdAt])
}

model Report {
  id         String  @id @default(cuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Nullable so anonymous reports are possible and deleting a user does not
  // erase the moderation record.
  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  reason    String
  details   String?
  status    String   @default("open") // "open" | "reviewed" | "actioned" | "dismissed"
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([listingId])
}

// ---- NextAuth adapter tables (JWT strategy: Session stays empty but the
// adapter requires it; keeping it future-proofs a move to DB sessions). ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Forgot-password tokens. Only the SHA-256 hash is stored; the raw token
// exists solely inside the emailed link. Single-use via usedAt.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Business {
  id            String   @id @default(cuid())
  slug          String   @unique // kebab(name)-citySlug, collision-suffixed
  name          String
  description   String // neutral, factual
  category      String // BUSINESS_CATEGORIES slug
  subcategory   String?
  city          String // existing CITIES slug
  neighbourhood String?
  address       String
  phone         String?
  website       String?
  hours         String? // freeform display text, e.g. "Mon–Fri 9–6"
  images        String[]
  status        String   @default("active") // "active" | "hidden"
  source        String // "open-data" | "curated" | "self"
  verified      Boolean  @default(false) // true once a claim is approved
  claimedById   String? // owner (User.id) once a claim is approved

  claimedBy User?           @relation("BusinessOwner", fields: [claimedById], references: [id], onDelete: SetNull)
  claims    BusinessClaim[]
  reviews   Review[]
  events    Event[]

  // Where the business actually is. Nullable because coverage depends on the
  // source: the regional directories and Toronto Public Health publish
  // coordinates directly, while Toronto business licences carry only a street
  // address and are matched against the City of Toronto One Address
  // Repository. A row without coordinates simply never appears in a
  // distance search — it is never guessed at from a postal code, which would
  // put a restaurant up to a kilometre from where it really is.
  latitude  Float?
  longitude Float?

  // Denormalised review aggregates, written ONLY inside the same transaction
  // as the review that changes them (lib/reviews.ts). Kept on the row so
  // browse pages can show a rating without an aggregate query per card, and
  // so a rating can never be displayed without the count beside it.
  reviewCount Int @default(0)
  ratingSum   Int @default(0)

  // Subscription state. Every business is "free"; "pro" is the paid monthly
  // plan. The Stripe webhook is the ONLY writer of these four fields — the
  // same rule boosts follow (lib/webhook.ts).
  plan                 String    @default("free") // "free" | "pro"
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  planRenewsAt         DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Full-text search column. Prisma cannot express `tsvector` or the
  // GENERATED ALWAYS AS expression, so the migration is hand-edited to create it
  // as a generated column (name weight A, description weight B) with a GIN
  // index. Declared here as Unsupported so Prisma does not report schema drift
  // and try to drop it.
  searchVector Unsupported("tsvector")?

  @@index([category, city, status])
  @@index([city, status])
  @@index([claimedById])
}

/// A local event — Phase 5D.
///
/// Seeded from the City of Toronto's Festivals & Events feed (organiser
/// submitted, City reviewed, Open Government Licence – Toronto) and later from
/// business owners posting their own. Same rule as everything else here:
/// GTASearch never invents an event.
///
/// The City's feed publishes ONE ROW PER OCCURRENCE DATE — a month-long
/// exhibition appears thirty times — so the importer groups on sourceId and
/// stores a single row spanning the first and last date. Without that the
/// events page would be the same handful of festivals repeated down the page.
model Event {
  id   String @id @default(cuid())
  slug String @unique

  name        String
  description String
  category    String? // the City's own event_category, kept as published

  startsAt DateTime
  endsAt   DateTime

  venueName String?
  address   String?
  city      String
  /// Free-text price note as published ("Free", "$15 - $30"). Never computed:
  /// quoting a price we derived at someone's event is how people turn up with
  /// the wrong money.
  priceNote String?
  free      Boolean @default(false)

  website  String?
  imageUrl String?

  source   String // "open-data" | "self"
  /// The publisher's own id, so re-imports update rather than duplicate.
  sourceId String?
  status   String @default("published") // "published" | "hidden"

  /// Set only when a business owner posts their own event.
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceId])
  // The listing query is "published, in this city, not finished yet, soonest
  // first" — this index serves exactly that.
  @@index([status, city, endsAt])
  @@index([status, startsAt])
  @@index([businessId])
}

/// A review written by a signed-in person about a business.
///
/// GTASearch never generates, seeds, buys or imports reviews. Every row here
/// is written by a real account through the review form, which is why there is
/// no `source` column: there is only one way a review can exist. A directory
/// that invents its own social proof is worth nothing, and unwinding fake
/// reviews later is impossible.
model Review {
  id         String @id @default(cuid())
  businessId String
  userId     String

  rating Int // 1..5, enforced by a CHECK constraint added in the migration
  body   String

  /// The owner's public reply. Owners may answer but may never edit, hide or
  /// delete a review — that is the whole point of a review.
  ownerResponse    String?
  ownerRespondedAt DateTime?

  status    String   @default("published") // "published" | "hidden" (moderation)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One review per person per business. Re-reviewing edits the existing row,
  /// so nobody can stack five-star ratings on their own shop or bury a rival.
  @@unique([businessId, userId])
  @@index([businessId, status, createdAt])
  @@index([userId])
}

/// An owner's request to take control of a Business listing.
///
/// Reviewed by hand in /admin/claims. Automated proof (a code emailed to the
/// business's published address, or texted to its published phone) needs an
/// email/SMS provider the project does not have configured yet; manual review
/// is what works today and is honest about it. The evidence fields exist so a
/// reviewer has something concrete to check against the public record.
model BusinessClaim {
  id         String @id @default(cuid())
  businessId String
  userId     String

  // Snapshot of what the claimant asserted, kept even after review so a
  // decision can be audited later.
  contactName  String
  contactEmail String
  contactPhone String?
  roleAtBusiness String // "owner" | "manager" | "employee" | "agency"
  evidence     String // free text: website, business number, anything checkable

  status     String    @default("pending") // "pending" | "approved" | "rejected"
  reviewNote String?
  reviewedAt DateTime?
  reviewedById String?

  createdAt DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation("ClaimSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // One claim per person per business: re-submitting edits the existing row
  // rather than flooding the review queue. A partial unique index restricting
  // this to pending rows is added by hand in the migration so a rejected
  // claimant can try again with better evidence.
  @@index([status, createdAt])
  @@index([businessId])
  @@index([userId])
}
