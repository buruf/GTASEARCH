# GTASearch — environment variable reference
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.

# ---------------------------------------------------------------------------
# PHASE 1 — required now
# ---------------------------------------------------------------------------

# Supabase transaction pooler (port 6543). Used by the app at runtime.
# The pgbouncer flag is required: Prisma must not use prepared statements
# against a transaction-mode pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase session pooler (port 5432). Used only by migrations and seeding.
# Prefer this over the db.<ref>.supabase.co host, which is IPv6-only unless the
# IPv4 add-on is purchased.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# PHASE 2 — accounts, posting, image upload. Not required yet.
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# PHASE 3 — boosts, email, moderation. Not required yet.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TOP_AD=
STRIPE_PRICE_FEATURED=
STRIPE_PRICE_SUPER_BOOST=
RESEND_API_KEY=
ADMIN_EMAIL=
